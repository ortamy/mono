# Секреты серверной лид-формы (app/api/lead).
# Этот файл НЕ должен попадать в git — он в .gitignore.
# Все четыре переменные читаются только на сервере: Next.js не инлайнит их в
# клиентский бандл, поэтому токен бота нельзя увидеть в исходниках страницы.
#
# Возьмите значения на хостинге в настройках проекта (Vercel/Render/Railway).

# Supabase: Project Settings -> Data API -> Project URL и service_role key.
# Именно service_role, НЕ anon key: запись идёт с сервера в обход RLS.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Telegram: токен от @BotFather, chat_id — id чата/канала с ботом.
# Узнать chat_id: написать боту, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять chat.id.
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-1001234567890

# Сайт живёт в подкаталоге /mono только на GitHub Pages.
# На своём домене (Render) укажите реальный: https://mono-79im.onrender.com
NEXT_PUBLIC_SITE_URL=https://ortamy.github.io/mono
NEXT_PUBLIC_BASE_PATH=

# Яндекс.Метрика: ID счётчика из metrika.yandex.ru. Пока переменная пустая,
# счётчик не подключается и цели не отправляются (см. lib/metrika.ts).
NEXT_PUBLIC_METRIKA_ID=

# agentation — dev-инструмент обратной связи для ИИ-агентов
# (npm i -D agentation, см. components/dev/dev-agentation.tsx). Работает только
# в dev-режиме, в продакшене тулбар не рендерится.
# Оставьте пустым: замечания копятся в браузере и копируются в буфер обмена.
# Укажите http://localhost:4747, если запущен MCP-сервер
# (`npx -y agentation-mcp server`) — тогда тулбар отправит разметку агенту сам.
NEXT_PUBLIC_AGENTATION_ENDPOINT=

# off — полностью выключить тулбар agentation в dev-режиме.
NEXT_PUBLIC_AGENTATION=
